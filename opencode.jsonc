{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@latest",
    "./opencode-codex-identity-plugin.ts",
    "@dietrichgebert/ponytail"
  ],
  "share": "manual",
  "permission": {
    "task": "deny",
    "read": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000,
    "tail_turns": 8
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["/home/pedro/.local/bin/headroom", "mcp", "serve"],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": ["/home/pedro/.local/bin/graphify-mcp", "graphify-out/graph.json"],
      "enabled": true
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "permission": {
        "subtask": "deny",
        "edit": "allow",
        "task": "deny"
      }
    },
    "orchestrator": {
      "permission" : {
        "edit": "deny",
        "task": "allow"
      }
    }
  },
  "lsp": true
}
