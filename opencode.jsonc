{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    "@cortexkit/opencode-magic-context@0.33.1",
    "@dietrichgebert/ponytail",
    "opencode-skills",
    "oh-my-opencode-slim"
  ],
  "share": "manual",
  "permission": {
    "task": "deny",
    "read": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000,
    "tail_turns": 8
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["/home/pedro/.local/bin/headroom", "mcp", "serve"],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": ["/home/pedro/.local/bin/graphify-mcp", "graphify-out/graph.json"],
      "enabled": true
    },
    "camoufox": {
      "type": "local",
      "command": ["npx", "-y", "camoufox-mcp-server@latest"],
      "enabled": true
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-4a5b8d9bc69edb37-5facda-5b1d76d1"
      },
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "task": "deny"
      }
    },
    "orchestrator": {
      "permission" : {
        "edit": "deny",
        "task": "allow"
      }
    }
  },
  "lsp": true
}
