{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "share": "manual",
  "permission": {
    "edit": "deny",
    "task": "allow",
    "read": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000,
    "tail_turns": 8
  },
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.2",
      "variant": "max",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    "build": {
      "model": "opencode-go/mimo-v2.5",
      "variant": "high",
      "permission": {
        "subtask": "deny",
        "edit": "allow",
        "task": "deny"
      }
    },
  },
  "lsp": true
}
