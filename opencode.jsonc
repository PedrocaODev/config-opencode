{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "opencode-go/deepseek-v4-flash",
  "autoupdate": "notify",
  "plugin": [
    "opencode-antigravity-auth@latest",
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "share": "manual",
  "permission": {
    "edit": "deny",
    "task": "allow",
    "read": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000,
    "tail_turns": 8
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "skill": "deny",
        "task": "deny"
      }
    },
    "build": {
      "model": "opencode-go/mimo-v2.5",
      "variant": "high",
      "permission": {
        "subtask": "deny",
        "edit": "allow",
        "bash": "deny",
        "task": "deny"
      }
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
